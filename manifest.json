{
  "manifest_version": 3,
  "name": "Exact URL Usage Tracker",
  "version": "1.0.0",
  "description": "Track open-tab time for exact URLs — perfect for GitHub Codespaces quota monitoring.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Exact URL Tracker"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
